# Copie este arquivo para ".env" e defina uma senha própria.
# O arquivo ".env" NÃO vai para o Git (contém credenciais).

# --- PostgreSQL local do projeto (usado por scripts/db.mjs) ---
POSTGRES_USER=gestao_ti
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=gestao_ti
POSTGRES_PORT=5433
# Opcional: pasta "bin" do PostgreSQL. Se vazio, usa a versão mais recente
# instalada em "C:\Program Files\PostgreSQL".
# PG_BIN="C:\Program Files\PostgreSQL\18\bin"

# --- Aplicação ---
# Banco REAL:
DATABASE_URL="postgresql://gestao_ti:troque_esta_senha@localhost:5433/gestao_ti?schema=public"
# Banco de DEMONSTRAÇÃO (dados fictícios, isolados):
DEMO_DATABASE_URL="postgresql://gestao_ti:troque_esta_senha@localhost:5433/gestao_ti_demo?schema=public"

# Qual banco a aplicação usa: "real" (padrão) ou "demo" (dados fictícios)
APP_DATA_MODE=real
